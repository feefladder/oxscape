  urldate = {2024-03-24},
  abstract = {The 'Courant-Friedrichs-Lewy (CFL) criterion' is a condition in solving numerical equations that states that, given a spatial resolution or discretization, a time step larger than some computable quantity should not be taken. In LEM LAPSUS, a multi modular reduced complexity model, this criterion is expected to be violated, since annual or larger time-steps are chosen above ideal re-sedimentation budgets that might slow down considerably computation speed in complex landscapes. In this LEM experiment we simulate the effect of changing the temporal resolution (time-step) on various landscapes, without changing any of the other LEM formulations or conditions. Consequently model results tell us something on the stability of our model formulations and whether the above mentioned assumptions indeed justify the violation of the CLF criterion.},
  eventtitle = {{{EGU General Assembly Conference Abstracts}}},
  annotation = {ADS Bibcode: 2014EGUGA..1615757S},
  file = {/home/user/Zotero/storage/MEKN69RC/Schoorl et al. - 2014 - Time step and stepping time Temporal resolution a.pdf}
